# OpenCode server — dung glibc (bookworm-slim), KHONG dung alpine.
#
# Ly do: goi `opencode-ai` cai binary bien dich bang Bun; alpine dung musl chu
# khong phai glibc. Day la lop loi rat pho bien, va Milestone 0 khong nen dot
# thoi gian debug musl — image lon hon ~80 MB trong khi vpn4 con 33 GB dia.
#
# Ghi phien ban that vao day sau khi Milestone 0 chot; KHONG dung tag troi.
ARG OPENCODE_VERSION=0.0.0-can-ghim

FROM node:22-bookworm-slim

# Cong cu agent thuc su can. Thieu chung thi moi tool cua no deu loi:
#   git          — doc/sua repo, tao nhanh
#   openssh-client — git qua ssh
#   ripgrep      — tool grep cua OpenCode
#   ca-certificates — goi cliproxy qua mang edge
#   curl         — healthcheck cua compose. node:22-bookworm-slim KHONG co san
#                  wget lan curl; healthcheck dau tien dung wget va container
#                  khong bao gio `healthy`, keo theo gateway khong bao gio khoi
#                  dong vi `condition: service_healthy`. Alpine co busybox wget
#                  san nen gateway va pg-tunnel khong gap loi nay — de nham vi vay.
#   tini         — tien trinh con (bash tool, git) khong thanh zombie khi agent
#                  huy task giua chung
#   python3      — script cua skill (skill_new/) deu viet bang Python. Thieu no
#                  thi agent goi script va nhan "command not found" — mot loi
#                  no khong the tu sua, va nguoi dung chi thay skill "khong chay".
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git openssh-client ripgrep ca-certificates curl tini python3 \
 && rm -rf /var/lib/apt/lists/*

ARG OPENCODE_VERSION
RUN npm i -g "opencode-ai@${OPENCODE_VERSION}" && npm cache clean --force

# MCP server cuc bo — CAI LUC BUILD, khong `npx -y` luc chay.
#
# Do duoc 2026-08-18: ca context7 lan exa deu `status=failed, Operation timed out
# after 15000ms`. `npx -y` phai tai goi tu registry MOI LAN container khoi dong —
# khong cache npm, may o Peru, va 15 giay la khong du. OpenCode nuot loi nay IM
# LANG: khong log, khong canh bao, agent chi don gian khong co tool va tra loi
# "minh khong lam duoc". Do la trieu chung nguoi dung gap khi xin hinh anh.
#
# Cai luc build doi ba thu: khong phu thuoc mang luc khoi dong, khong ton thoi
# gian moi lan restart, va phien ban duoc ghim (tai lap duoc).
#
# `command -v` la phep kiem BAT BUOC, khong phai trang tri: neu ten binary khac
# ten goi thi build DUNG NGAY o day, thay vi im lang thanh mot MCP chet ma chi
# phat hien duoc bang cach do that.
RUN npm i -g @upstash/context7-mcp exa-mcp-server \
 && command -v context7-mcp \
 && command -v exa-mcp-server \
 && npm cache clean --force

# Chay HAI lan trong deploy (buoc 4 truoc `up -d`, va buoc 5). Duong dan tuyet doi.
COPY scripts/verify-opencode-config.cjs /opt/verify-opencode-config.cjs

# Thu muc cau hinh phai ton tai TRUOC khi compose bind-mount mot FILE vao trong no.
RUN mkdir -p /home/node/.config/opencode && chown -R node:node /home/node/.config

# Thu muc du lieu (phien, lich su, quyen da duyet 'always') PHAI ton tai trong
# image voi dung chu so huu, du compose se gan volume de len.
#
# Ly do: khi Docker tao mot named volume RONG, no gieo noi dung tu duong dan
# tuong ung trong image — KE CA CHU SO HUU. Neu duong dan do khong ton tai,
# Docker tao mot thu muc rong thuoc root:root, va tien trinh chay bang uid 1000
# khong ghi duoc. Trieu chung khong he chi ve quyen: container don gian la khong
# bao gio `healthy`, va deploy dung o "dependency failed to start".
#
# Da xay ra dung nhu vay ngay 2026-08-18, ngay lan dau them volume.
RUN mkdir -p /home/node/.local/share/opencode && chown -R node:node /home/node/.local
# git tu choi lam viec trong repo thuoc user khac ("dubious ownership"); workspace
# duoc clone bang root tren host roi chown 1000.
RUN git config --system --add safe.directory /workspace \
 && git config --system --add safe.directory '/workspace/*'

USER node
ENTRYPOINT ["/usr/bin/tini", "--"]
# --hostname 0.0.0.0 chi co nghia trong khong gian mang cua container; compose
# KHONG publish cong nao nen no van khong lo ra host (§34).
CMD ["opencode", "serve", "--port", "4096", "--hostname", "0.0.0.0"]
