{
  "$schema": "https://opencode.ai/config.json",
  "//": "Khuon. `models` de RONG co y — scripts/sync-models.cjs tham do CLIProxy luc deploy va dien vao opencode.json that. Danh sach viet tay se lech dan khoi thu CLIProxy phuc vu.",
  "theme": "tokyonight",
  "//model": "Model MAC DINH cua server. Thieu khoa nay thi app desktop 1.18.30 giao dien v2 (Mac) khong chon duoc model: no hoi server model mac dinh (/api/model/default khong ton tai tren server 1.18.30, tra HTML), khong co thi tai lai vo han (do 2026-09-12). Phai la mot model co trong provider.cliproxy.models sau sync — verify-opencode-config.cjs kiem.",
  "model": "cliproxy/claude-opus-5",
  "instructions": [
    "AGENTS.md"
  ],
  "//mcp": "context7/exa goi BINARY da cai san trong image (xem Dockerfile), khong `npx -y`: do duoc 2026-08-18 la ca hai deu failed voi \"Operation timed out after 15000ms\" vi npx phai tai goi tu registry moi lan khoi dong. OpenCode nuot loi do IM LANG. tavily bat include_images: nguoi dung hoi \"tim anh\" ma cong cu tim kiem duoc cau hinh KHONG tra ve anh nao thi agent khong co gi de dua, va no bia ra la \"da tao collage\". brave van dung npx vi dang tat (enabled:false). Moi khoa API la {env:...}, gia tri di qua .env.opencode.",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "exa": {
      "type": "local",
      "command": [
        "exa-mcp-server"
      ],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "brave": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "DEFAULT_PARAMETERS": "{\"search_depth\":\"basic\",\"max_results\":5,\"include_answer\":false,\"include_raw_content\":false,\"include_images\":true}"
      }
    }
  },
  "//skills": "Thu muc skill duoc mount :ro tu ./skill_new (xem docker-compose.yml). Hinh dang {paths:[...]} lay tu Config.skills trong dac ta da tai ve, khong doan. permission.skill = \"ask\" nen agent hoi truoc khi dung.",
  "skills": {
    "paths": [
      "/opt/skills"
    ]
  },
  "//permission": "webfetch/websearch la \"allow\" theo yeu cau cua nguoi dung (2026-08-18) de cac MCP tim kiem chay tron. Danh doi da biet: agent goi duoc URL tuy y ma khong hoi, tuc no co the mang noi dung workspace ra ngoai. 2026-09-11 nguoi dung yeu cau agent doc/ghi/thuc thi day du KHONG hoi: bash[\"*\"], task, skill, external_directory chuyen sang \"allow\" (de lam viec o /workspace/<project> ngoai working_dir). Ban do deny van nguyen — deny khong hoi, chi chan.",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "deny",
    "edit": "allow",
    "question": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "context7_*": "allow",
    "exa_*": "allow",
    "brave_*": "allow",
    "tavily_*": "allow",
    "external_directory": "allow",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "kubectl *": "deny",
      "git push*": "allow",
      "git reset --hard*": "deny"
    }
  },
  "//lsp": "permission.lsp la quyen cua TOOL; khoi `lsp` nay moi la cong tac tat SERVER. Hai thu khac nhau.",
  "lsp": {
    "typescript": {
      "disabled": true
    }
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxy (vpn4)",
      "options": {
        "baseURL": "{env:CLIPROXY_BASE_URL}",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {}
    }
  }
}
