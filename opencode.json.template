{
  "$schema": "https://opencode.ai/config.json",
  "//": "Khuon. `models` de RONG co y — scripts/sync-models.cjs tham do CLIProxy luc deploy va dien vao opencode.json that. Danh sach viet tay se lech dan khoi thu CLIProxy phuc vu.",
  "theme": "tokyonight",
  "instructions": [
    "AGENTS.md"
  ],
  "//mcp": "context7/exa goi BINARY da cai san trong image (xem Dockerfile), khong `npx -y`: do duoc 2026-08-18 la ca hai deu failed voi \"Operation timed out after 15000ms\" vi npx phai tai goi tu registry moi lan khoi dong. OpenCode nuot loi do IM LANG. brave van dung npx vi dang tat (enabled:false). Moi khoa API la {env:...}, gia tri di qua .env.opencode.",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "context7-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "exa": {
      "type": "local",
      "command": [
        "exa-mcp-server"
      ],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "brave": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true,
      "timeout": 60000,
      "headers": {
        "DEFAULT_PARAMETERS": "{\"search_depth\":\"basic\",\"max_results\":3,\"include_answer\":false,\"include_raw_content\":false,\"include_images\":false}"
      }
    }
  },
  "//skills": "Thu muc skill duoc mount :ro tu ./skill_new (xem docker-compose.yml). Hinh dang {paths:[...]} lay tu Config.skills trong dac ta da tai ve, khong doan. permission.skill = \"ask\" nen agent hoi truoc khi dung.",
  "skills": {
    "paths": [
      "/opt/skills"
    ]
  },
  "//permission": "webfetch/websearch la \"allow\" theo yeu cau cua nguoi dung (2026-08-18) de cac MCP tim kiem chay tron. Danh doi da biet: agent goi duoc URL tuy y ma khong hoi, tuc no co the mang noi dung workspace ra ngoai. `bash` van \"ask\" va ban do cam van nguyen.",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "deny",
    "edit": "allow",
    "question": "allow",
    "task": "ask",
    "skill": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "context7_*": "allow",
    "exa_*": "allow",
    "brave_*": "allow",
    "tavily_*": "allow",
    "external_directory": "ask",
    "doom_loop": "deny",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "kubectl *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny"
    }
  },
  "//lsp": "permission.lsp la quyen cua TOOL; khoi `lsp` nay moi la cong tac tat SERVER. Hai thu khac nhau.",
  "lsp": {
    "typescript": {
      "disabled": true
    }
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxy (vpn4)",
      "options": {
        "baseURL": "{env:CLIPROXY_BASE_URL}",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {}
    }
  }
}
