{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "timeout": 15000
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "enabled": false,
      "timeout": 15000,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true,
      "timeout": 15000,
      "headers": {
        "DEFAULT_PARAMETERS": "{\"search_depth\":\"basic\",\"max_results\":3,\"include_answer\":false,\"include_raw_content\":false,\"include_images\":false}"
      }
    }
  },
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "deny",
    "edit": "allow",
    "question": "allow",
    "task": "ask",
    "skill": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "context7_*": "allow",
    "exa_*": "allow",
    "brave_*": "allow",
    "tavily_*": "allow",
    "external_directory": "ask",
    "doom_loop": "deny",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "systemctl *": "deny",
      "docker *": "deny",
      "kubectl *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny"
    }
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxy (vpn4)",
