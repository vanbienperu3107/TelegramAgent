# Khuon cua .env — gen-env.py doc file nay, thay gia tri bi mat va chuoi giu cho
# dang __TEN__, roi ghi ra .env (chmod 600) tren vpn4.
#
# Gia tri de trong = do gen-env.py dien tu GitHub Secrets.
# KHONG commit .env that.

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_MODE=polling

# ─── PostgreSQL (derp-postgres tren vpn6, qua tunnel) ────────────────────────
DATABASE_URL=postgresql://opencode:__OPENCODE_PG_PASSWORD__@pg-tunnel:5433/opencode_remote
OPENCODE_PG_PASSWORD=
PG_POOL_MAX=4
PG_CONNECT_TIMEOUT_S=15
PG_IDLE_TIMEOUT_S=0
PG_STATEMENT_TIMEOUT_MS=8000

# ─── OpenCode server (cung may, mang docker opencode_net) ────────────────────
OPENCODE_URL=http://opencode-server:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_EVENT_PATH=/event
OPENCODE_HEALTH_PATH=/global/health

# ─── Model mac dinh ──────────────────────────────────────────────────────────
DEFAULT_PROVIDER=cliproxy
DEFAULT_MODEL=claude-opus-5
DEFAULT_AGENT=build
CLIPROXY_BASE_URL=http://cliproxy:8317/v1
CLIPROXY_API_KEY=

# ─── Workspace (V1 dung 1 project) ───────────────────────────────────────────
WORKSPACE_ROOT=/workspace
DEFAULT_PROJECT_NAME=sandbox
DEFAULT_PROJECT_PATH=/workspace/opencode-sandbox

# ─── Gioi han ────────────────────────────────────────────────────────────────
MAX_PROMPT_BODY_MB=8
MAX_INPUT_ATTACHMENT_MB=5
MAX_OUTPUT_ARTIFACT_MB=45
APPROVAL_TIMEOUT_MIN=30
TASK_MAX_DURATION_MIN=30

# ─── Telegram UI ─────────────────────────────────────────────────────────────
MODEL_PAGE_SIZE=8
SESSION_PAGE_SIZE=8
PROJECT_PAGE_SIZE=8

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
HEALTH_PORT=8790
